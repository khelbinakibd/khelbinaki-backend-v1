# =============================================================================
# Turf Booking System - Environment Variables
# =============================================================================
# This file contains all the environment variables needed to run the application.
# Copy this file to .env.development or .env.production and fill in the values.
#
# IMPORTANT: Never commit .env files with real credentials to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development                    # Options: development | production | test
PORT=9000                               # Port number for the backend server

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection string
# For local MongoDB: mongodb://127.0.0.1:27017/turf_booking_dev
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb://127.0.0.1:27017/turf_booking_dev

# Database connection pool settings (optional)
DB_MAX_POOL_SIZE=10                     # Maximum number of connections in pool
DB_MIN_POOL_SIZE=2                      # Minimum number of connections in pool

# -----------------------------------------------------------------------------
# URLs Configuration
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173        # Frontend URL (React/Vite dev server)
SERVER_URL=http://localhost:9000        # Backend API URL
PUBLIC_URL=http://localhost:9000        # Public URL for email links (optional)

# -----------------------------------------------------------------------------
# JWT (JSON Web Token) Configuration
# -----------------------------------------------------------------------------
# Generate secure random strings (32+ characters recommended)
# You can generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=1h                       # Access token expiration (e.g., 15m, 1h, 1d)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long
REFRESH_EXPIRES_IN=7d                   # Refresh token expiration (e.g., 7d, 30d)

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
BCRYPT_SALT_ROUND=10                    # Bcrypt salt rounds (10 for dev, 12+ for prod)
SECURE_COOKIES=false                    # Set to true in production (requires HTTPS)
COOKIE_DOMAIN=                          # Optional: .yourdomain.com for subdomain cookies

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Email Service Configuration
# -----------------------------------------------------------------------------
# Email service provider: nodemailer (SMTP) or resend
EMAIL_SERVICE=nodemailer

# --- For Nodemailer (SMTP) ---
# Use these for local development with MailHog or production SMTP server
EMAIL_HOST=localhost                    # SMTP host (localhost for MailHog, smtp.gmail.com for Gmail)
EMAIL_PORT=1025                         # SMTP port (1025 for MailHog, 587 for TLS, 465 for SSL)
EMAIL_USER=                             # SMTP username (leave empty for MailHog)
EMAIL_PASSWORD=                         # SMTP password (leave empty for MailHog)
EMAIL_FROM="Turf Booking System <noreply@turfbooking.com>"

# --- For Resend (Production Recommended) ---
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_your_resend_api_key_here
# EMAIL_FROM="Your App Name <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Cloudinary Configuration (Image Upload Service)
# -----------------------------------------------------------------------------
# Sign up at https://cloudinary.com to get these credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------------------------
# Super Admin (Manager) Account
# -----------------------------------------------------------------------------
# This account is automatically created on first startup
MANAGER_EMAIL=admin@example.com
MANAGER_PASSWORD=ChangeThisPassword123!
MANAGER_NAME=Super Admin

# -----------------------------------------------------------------------------
# Rate Limiting (API Request Throttling)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000             # Time window in milliseconds (15 minutes = 900000)
RATE_LIMIT_MAX_REQUESTS=100             # Maximum requests per IP within the time window

# -----------------------------------------------------------------------------
# Development/Production Specific Settings
# -----------------------------------------------------------------------------
DEBUG_MODE=false                        # Enable debug mode (true/false)
LOG_LEVEL=info                          # Logging level: debug | info | warn | error
COMPRESSION=true                        # Enable gzip compression (true/false)
CACHE_TTL=3600                          # Cache time-to-live in seconds

# =============================================================================
# NOTES FOR DEPLOYMENT
# =============================================================================
#
# FOR DEVELOPMENT:
# - Use nodemailer with MailHog for email testing
# - Use lower bcrypt salt rounds (10) for faster hashing
# - SECURE_COOKIES should be false
# - Can use local MongoDB or a development database
#
# FOR PRODUCTION:
# - Use resend or a production SMTP service for emails
# - Use higher bcrypt salt rounds (12+) for better security
# - SECURE_COOKIES must be true (requires HTTPS)
# - Use MongoDB Atlas or a production database
# - Generate new, secure JWT secrets (different from development)
# - Change the default MANAGER_PASSWORD immediately
# - Set appropriate RATE_LIMIT values to prevent abuse
# - Update CLIENT_URL and SERVER_URL to production domains
# - Ensure all secrets are set in your hosting platform's environment variables
#
# SECURITY TIPS:
# - Never use the same JWT secrets in development and production
# - Keep your .env files in .gitignore
# - Rotate API keys and secrets periodically
# - Use environment variables on hosting platforms (Render, Heroku, Railway, etc.)
# - Enable 2FA for all third-party services (MongoDB Atlas, Cloudinary, etc.)
#
# =============================================================================
